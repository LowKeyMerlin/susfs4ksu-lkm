(allow kernel self (process (fork sigchld)))

; Every domain is permissive and the policy grants nothing, so each access would be audited, and
; the kernel prints an audit record in the middle of the line the test is writing to the console.
; Nothing is audited.
(dontaudit domain unlabeled (dir (all)))
(dontaudit domain unlabeled (file (all)))
(dontaudit domain unlabeled (lnk_file (all)))
(dontaudit domain unlabeled (chr_file (all)))
(dontaudit domain unlabeled (blk_file (all)))
(dontaudit domain unlabeled (sock_file (all)))
(dontaudit domain unlabeled (fifo_file (all)))
(dontaudit domain unlabeled (memfd_file (all)))
(dontaudit domain unlabeled (unix_stream_socket (all)))
(dontaudit domain unlabeled (security (all)))
(dontaudit domain domain (process (all)))
(dontaudit domain domain (fd (all)))
