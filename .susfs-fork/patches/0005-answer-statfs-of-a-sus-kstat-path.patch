+		    !susfs_kstat_gate_ok())				\
+			return orig(regs);				\
+		syscall_get_arguments(current, (struct pt_regs *)regs, a);	\
+		return susfs_kstatfs_answer(layout, by_fd, combat, a);	\
+	}
